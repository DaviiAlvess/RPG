# Gemini (Mestre IA) — obrigatório na Vercel
GEMINI_API_KEY=sua_chave_aqui
# Opcional: chaves extras para rodízio quando uma bater cota (429) ou falhar.
# Todas as chaves únicas configuradas (slots 1–7) entram no rodízio.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=
# GEMINI_API_KEY_7=
# Orçamento diário (UTC) de tokens rastreados por chave. Padrão: 250000.
# GEMINI_KEY_TOKEN_BUDGET=250000
GEMINI_MODEL=gemini-3.5-flash-lite
# Se o modelo acima estiver indisponível, o servidor tenta gemini-2.5-flash e gemini-2.0-flash.
# Opcional: modelo separado para contexto e fichas; usa GEMINI_MODEL quando vazio.
GEMINI_LORE_MODEL=

# Firebase (opcional — já há valores padrão do projeto siterpg32 no código)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
